<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LogCarverGuard.Local</AssemblyName>
    <RootNamespace>LogCarverGuard.Local</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>logcarverguard</ToolCommandName>
    <PackageType>McpServer</PackageType>
    <PackageId>LogCarverGuard.Local</PackageId>
    <Version>0.1.0</Version>
    <Authors>Derek</Authors>
    <Description>Local MCP server that puts a statement guard, an optional read-only mode and an audit log between an AI agent and your SQL Server.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;modelcontextprotocol;sqlserver;guard;audit;read-only</PackageTags>
    <RepositoryUrl>https://github.com/caiderek/LogCarverGuard</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogCarverGuard.Core\LogCarverGuard.Core.csproj" />
    <ProjectReference Include="..\LogCarverGuard.Tools\LogCarverGuard.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\.mcp\server.json" Pack="true" PackagePath="\.mcp\" Condition="Exists('..\..\.mcp\server.json')" />
  </ItemGroup>

</Project>
